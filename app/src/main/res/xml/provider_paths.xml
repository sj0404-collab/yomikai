<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path
        name="cache_files"
        path="." />
    <external-path
        name="ext"
        path="." />
    <external-cache-path
        name="ext_cache_files"
        path="." />
    <external-files-path
        name="ext_files"
        path="." />
    <!-- AI-workspace может лежать во внутреннем хранилище (files/ai_workspace),
         когда внешнее SD/основное хранилище недоступно/размонтировано. Без
         files-path FileProvider не может построить content:// URI для файлов
         из internal files и крашится при «Поделиться» (IllegalArgumentException:
         Failed to find configured root). -->
    <files-path
        name="files_ai_workspace"
        path="ai_workspace/" />
    <!--suppress AndroidElementNotAllowed -->
    <root-path
        name="ext_storage"
        path="/storage/" />
</paths>
